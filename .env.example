APP_NAME="MastApp Test Task"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
NGINX_PORT=4400
APP_URL=http://localhost:4400

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Если переменная не задана, Laravel использует database/database.sqlite.
# Оставляем путь относительным к корню проекта, чтобы он одинаково работал
# локально и внутри Docker-контейнера.
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

REFERRAL_PERCENT=10
